{
  "name": "@payraider/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the PayRaider API",
  "homepage": "https://github.com/Pay-Raider/payraider-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pay-Raider/payraider-plugin.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/Pay-Raider/payraider-plugin/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "generate": "bash scripts/generate-bindings.sh",
    "test": "vitest run",
    "test:testnet": "vitest run --include 'tests/testnet/**/*.test.ts'",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "sdk",
    "payments",
    "analytics",
    "request-deduplication",
    "network-context",
    "authentication",
    "retry-backoff"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "private": true
}
